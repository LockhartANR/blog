<article class="post">
  <a class="back-link" href="<%- url_for('/') %>">← 所有文章</a>
  <header class="post-header">
    <div class="post-meta"><time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY 年 M 月 D 日') %></time><% page.tags.each(function(tag) { %><a href="<%- url_for(tag.path) %>"><%= tag.name %></a><% }) %></div>
    <h1><%= page.title %></h1>
    <p class="post-author"><%= page.author || config.author %></p>
  </header>
  <% const contents = toc(page.content, { list_number: false }); if (contents) { %>
    <details class="post-toc"><summary>文章目录</summary><nav aria-label="文章目录"><%- contents %></nav></details>
  <% } %>
  <div class="prose"><%- page.content %></div>
  <nav class="post-neighbors" aria-label="相邻文章">
    <% if(page.prev) { %><a href="<%- url_for(page.prev.path) %>">← <%= page.prev.title %></a><% } %>
    <% if(page.next) { %><a href="<%- url_for(page.next.path) %>"><%= page.next.title %> →</a><% } %>
  </nav>
</article>

